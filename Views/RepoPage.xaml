<Page x:Class="FluentGit.Views.RepoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
    <Grid>
        <!-- 主内容居中 -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15">
            <!-- 正常显示的标题 -->
            <TextBlock x:Name="MainContent" Text="仓库管理页面" FontSize="24" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            
            <!-- Git 警告面板（默认隐藏） -->
            <StackPanel x:Name="GitWarningPanel" Visibility="Collapsed" Spacing="10">
                <TextBlock Text="未检测到 Git，请先安装 Git" 
                           FontSize="16" 
                           Foreground="Red" 
                           HorizontalAlignment="Center" />
                <HyperlinkButton Content="下载 Git for Windows" 
                                 NavigateUri="https://git-scm.com/install/windows" 
                                 HorizontalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>