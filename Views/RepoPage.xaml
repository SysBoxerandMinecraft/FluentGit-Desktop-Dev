<Page x:Class="FluentGit.Views.RepoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15">
            <!-- 正常显示的标题 -->
            <TextBlock x:Name="MainContent" Text="仓库管理页面" FontSize="24" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            
            <!-- Git 警告面板（默认隐藏） -->
            <StackPanel x:Name="GitWarningPanel" Visibility="Collapsed" Spacing="10">
                <TextBlock Text="未检测到 Git，请先安装 Git" 
                           FontSize="16" 
                           Foreground="Red" 
                           HorizontalAlignment="Center" />
                <HyperlinkButton Content="下载 Git for Windows" 
                                 NavigateUri="https://git-scm.com/install/windows" 
                                 HorizontalAlignment="Center" />
            </StackPanel>

            <!-- 仓库操作区域 -->
            <StackPanel x:Name="RepoActionsPanel" Visibility="Visible" Spacing="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="RepoPathTextBox" Grid.Column="0" 
                             PlaceholderText="选择或输入要初始化的目录路径" 
                             Margin="0,0,10,0" MinWidth="300" />
                    <Button Grid.Column="1" Content="浏览..." Click="OnBrowseForInit" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <Button x:Name="InitRepoButton" Content="初始化仓库" Click="OnInitRepository" />
                    <Button x:Name="OpenRepoButton" Content="打开仓库" Click="OnOpenRepo" />
                </StackPanel>
                <TextBlock x:Name="RepoStatusText" FontSize="14" Foreground="Gray" HorizontalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>