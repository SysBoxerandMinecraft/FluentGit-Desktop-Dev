<Page x:Class="FluentGit.Views.RepoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:FluentGit.Views"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      NavigationCacheMode="Required">
    <Page.Resources>
        <Storyboard x:Name="SlideInStoryboard">
            <DoubleAnimation Storyboard.TargetName="InfoBarTransform" Storyboard.TargetProperty="Y"
                             From="-80" To="0" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="InfoBarContainer" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Name="SlideOutStoryboard">
            <DoubleAnimation Storyboard.TargetName="InfoBarTransform" Storyboard.TargetProperty="Y"
                             From="0" To="-80" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="InfoBarContainer" Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>
    <Grid>
        <!-- InfoBar 容器 -->
        <Border x:Name="InfoBarContainer"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="20,20,20,0"
                MinWidth="400"
                Opacity="0"
                Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="InfoBarTransform" Y="-80" />
            </Border.RenderTransform>
            <InfoBar x:Name="StatusInfoBar"
                     IsOpen="True"
                     IsClosable="False"
                     Severity="Success"
                     Title=""
                     Message="" 
                     MaxWidth="500"/>
        </Border>

        <!-- 主内容 -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="30,90,30,30" MinWidth="400">
                <TextBlock x:Name="RepoNameDisplay" FontSize="24" FontWeight="SemiBold"
                           Visibility="Collapsed" Margin="0,0,0,15" />

                <StackPanel x:Name="GitWarningPanel" Visibility="Collapsed" Spacing="10" Margin="0,0,0,15">
                    <TextBlock Text="未检测到 Git，请先安装 Git" FontSize="16" Foreground="Red" />
                    <HyperlinkButton Content="下载 Git for Windows" NavigateUri="https://git-scm.com/install/windows" />
                </StackPanel>

                <StackPanel x:Name="RepoActionsPanel" Visibility="Visible" Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RepoPathTextBox" Grid.Column="0"
                                 PlaceholderText="选择或输入要初始化的目录路径"
                                 MinHeight="32" Margin="0,0,10,0" />
                        <Button Grid.Column="1" Content="浏览..." Click="OnBrowseForInit" MinHeight="32" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="InitRepoButton" Content="初始化仓库" Click="OnInitRepository" MinHeight="32" />
                        <Button x:Name="OpenRepoButton" Content="打开仓库" Click="OnOpenRepo" MinHeight="32" />
                    </StackPanel>
                </StackPanel>

                <!-- ★ 仓库操作面板（打开仓库后显示） -->
                <Border x:Name="RepoOpsPanel"
                        BorderBrush="Gray" BorderThickness="0,1,0,0"
                        Padding="0,10,0,0" Margin="0,15,0,0"
                        Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <TextBlock Text="仓库操作" FontWeight="SemiBold" FontSize="16" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="PullButton" Content="更新（git pull）"
                                    Click="OnPullRepository" MinHeight="32" />
                            <Button x:Name="FetchButton" Content="获取（git fetch）"
                                    Click="OnFetchRepository" MinHeight="32" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="ClonePanel" BorderBrush="Gray" BorderThickness="0,1,0,0"
        Padding="0,10,0,0" Margin="0,15,0,0" Visibility="Collapsed">
    <StackPanel Spacing="10">
        <TextBlock Text="克隆远程仓库" FontWeight="SemiBold" FontSize="16" />
        <TextBox x:Name="CloneUrlTextBox"
                 PlaceholderText="例如: https://github.com/用户名/仓库.git"
                 MinHeight="32" />
        <TextBlock x:Name="CloneTargetHint"
                   Text="将克隆到当前仓库目录（会删除 .git）"
                   FontSize="12" Foreground="Gray" />
        <Button x:Name="CloneButton" Content="克隆"
                Click="OnCloneRepository" HorizontalAlignment="Left" MinHeight="32" />
    </StackPanel>
</Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>