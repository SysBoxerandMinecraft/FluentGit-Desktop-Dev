<Page x:Class="FluentGit.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
    <Page.Resources>
        <!-- 滑入：从上方滑下来 + 淡入 -->
        <Storyboard x:Name="SlideInStoryboard">
            <DoubleAnimation Storyboard.TargetName="InfoBarTransform"
                             Storyboard.TargetProperty="Y"
                             From="-30" To="0"
                             Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="InfoBarContainer"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- 滑出：向上滑回去 + 淡出 -->
        <Storyboard x:Name="SlideOutStoryboard">
            <DoubleAnimation Storyboard.TargetName="InfoBarTransform"
                             Storyboard.TargetProperty="Y"
                             From="0" To="-30"
                             Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="InfoBarContainer"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0"
                             Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部：设置 + InfoBar + 搜索框 -->
        <Grid Grid.Row="0" Margin="30,24,30,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="设置"
                       FontSize="28"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

            <Border x:Name="InfoBarContainer"
                    Grid.Column="1"
                    Margin="20,0,20,0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Opacity="0"
                    Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="InfoBarTransform" Y="-30"/>
                </Border.RenderTransform>
                <InfoBar x:Name="StatusInfoBar"
                         IsOpen="True"
                         IsClosable="False"
                         Severity="Success"
                         Title=""
                         Message=""
                         MinWidth="300"/>
            </Border>

            <AutoSuggestBox x:Name="SearchBox"
                            Grid.Column="2"
                            Width="300"
                            Height="36"
                            VerticalContentAlignment="Center"
                            PlaceholderText="搜索设置选项"
                            QueryIcon="Find"
                            TextChanged="OnSearchTextChanged"
                            QuerySubmitted="OnSearchQuerySubmitted"
                            SuggestionChosen="OnSearchSuggestionChosen"/>
        </Grid>

        <!-- 内容区 -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,6,30,30" Spacing="24">

                <TextBlock x:Name="NoResultText"
                           Text="未找到匹配的设置选项"
                           FontSize="14"
                           Foreground="Gray"
                           Visibility="Collapsed"
                           Margin="0,20,0,0"/>

                <!-- ==================== Git 管理 ==================== -->
                <StackPanel x:Name="GroupGit" Spacing="10">
                    <TextBlock Text="Git 管理"
                               FontSize="20"
                               FontWeight="SemiBold"/>

                    <Border x:Name="ItemGitPath"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Git 徽标 -->
                            <Image Grid.Column="0"
       Source="ms-appx:///Assets/GitAPPIcon.png"
       Width="110"
       Height="46"
       Stretch="Uniform"
       VerticalAlignment="Center"/>

                            <!-- 右侧信息 -->
                            <StackPanel Grid.Column="1" Spacing="10">
                                <TextBlock Text="Git 安装路径"
                                           FontSize="15"
                                           FontWeight="SemiBold"/>

                                <TextBlock x:Name="SelectedPathDisplay"
                                           Text="正在查找 Git..."
                                           FontSize="13"
                                           Foreground="Gray"
                                           TextWrapping="Wrap"/>

                                <TextBlock x:Name="GitVersionDisplay"
                                           Text=""
                                           FontSize="13"
                                           Foreground="Gray"
                                           Visibility="Collapsed"/>

                                <ProgressRing x:Name="LoadingRing"
                                              IsActive="True"
                                              Width="24" Height="24"
                                              HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ==================== 树状图显示选项 ==================== -->
                <StackPanel x:Name="GroupTreeView" Spacing="10">
                    <TextBlock Text="树状图显示选项"
                               FontSize="20"
                               FontWeight="SemiBold"/>

                    <Border x:Name="ItemFilterArtifacts"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16">
                        <StackPanel Spacing="6">
                            <CheckBox x:Name="FilterArtifactsCheckBox"
                                      Content="过滤编译产物 / 临时文件"
                                      Checked="OnFilterArtifactsChecked"
                                      Unchecked="OnFilterArtifactsUnchecked"/>
                            <TextBlock Text="在目录树中隐藏 bin、obj、node_modules、__pycache__ 等构建产物和依赖目录"
                                       FontSize="12"
                                       Foreground="Gray"
                                       TextWrapping="Wrap"
                                       Margin="28,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>