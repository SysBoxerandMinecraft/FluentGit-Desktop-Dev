<Page x:Class="FluentGit.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
    <Grid Margin="30,30,0,0">
        <StackPanel HorizontalAlignment="Left">
            <TextBlock Text="Git 安装路径" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>

            <TextBlock x:Name="SelectedPathDisplay" 
                       Text="正在查找 Git..." 
                       FontSize="14" 
                       Foreground="Gray" 
                       Margin="0,0,0,10"/>

            <ProgressRing x:Name="LoadingRing"
                          IsActive="True"
                          Width="24" Height="24"
                          HorizontalAlignment="Left"
                          Margin="0,0,0,10" />

            <!-- ★ 新增：过滤选项 -->
            <CheckBox x:Name="FilterArtifactsCheckBox"
                      Content="过滤编译产物 / 临时文件（bin、obj、node_modules 等）"
                      Margin="0,20,0,0"
                      Checked="OnFilterArtifactsChecked"
                      Unchecked="OnFilterArtifactsUnchecked" />

            <InfoBar x:Name="StatusInfoBar"
                     IsOpen="False"
                     IsClosable="False"
                     Severity="Success"
                     Title=""
                     Message=""
                     HorizontalAlignment="Left"
                     MinWidth="300"
                     Margin="0,15,0,0" />
        </StackPanel>
    </Grid>
</Page>